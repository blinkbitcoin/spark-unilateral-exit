{
  "name": "spark-unilateral-exit",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "bin": {
    "spark-unilateral-exit": "./src/cli.ts"
  },
  "scripts": {
    "test": "vitest run --coverage",
    "test:unit": "vitest run",
    "test:e2e": "RUN_SPARK_E2E=1 vitest run test/e2e --testTimeout 300000",
    "typecheck": "tsc --noEmit",
    "plan": "node src/cli.ts plan",
    "refresh-bundle": "node src/cli.ts refresh-bundle",
    "refresh-recovery-bundle": "node src/cli.ts refresh-bundle",
    "desktop:build": "node scripts/build-desktop.mjs",
    "desktop:start": "npm run desktop:build && electron dist-desktop/main.cjs",
    "desktop:typecheck": "tsc -p tsconfig.desktop.json --noEmit",
    "desktop:test": "vitest run --config desktop/vitest.config.ts --coverage",
    "desktop:test:ui": "npm run desktop:build && playwright test --config desktop/playwright.config.ts"
  },
  "dependencies": {
    "@buildonspark/spark-sdk": "^0.8.6",
    "@noble/curves": "^1.9.7",
    "@noble/hashes": "^1.7.0",
    "@scure/bip32": "^1.7.0",
    "@scure/bip39": "^1.6.0",
    "@scure/btc-signer": "^1.5.0"
  },
  "//": [
    "overrides: @buildonspark/spark-sdk depends on ua-parser-js ^2.x, which is",
    "AGPL-3.0-or-later (relicensed from MIT at v2.0). AGPL is incompatible with",
    "this repo's MIT license for redistributed bundles, so we pin the last",
    "MIT-licensed major (1.x). The SDK only uses it for user-agent detection",
    "and the UAParser API it uses is compatible across 1.x/2.x."
  ],
  "overrides": {
    "ua-parser-js": "^1.0.41"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@types/node": "^22.15.0",
    "@vitest/coverage-v8": "5.0.0",
    "electron": "44.3.0",
    "esbuild": "0.28.2",
    "jsdom": "30.0.1",
    "typescript": "^5.7.0",
    "vitest": "5.0.0"
  },
  "engines": {
    "node": "^22.22.2 || ^24.15.0 || >=26.0.0"
  }
}
